{
  "name": "chart-type-assistant-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-graphs": "node scripts/sync-graphs.mjs",
    "predev": "npm run sync-graphs",
    "dev": "next dev",
    "prebuild": "npm run sync-graphs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run sync-graphs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run sync-graphs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.105.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
